{
  "manifest_version": 3,
  "name": "Identity Recall",
  "version": "0.1.0",
  "description": "Remember which email you used on each website. Local-first, no passwords.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Identity Recall",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mark.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
